# --- Dependencies ---
node_modules/

# --- Environment / secrets ---
# .env files hold real secrets (JWT signing keys, Paystack keys, DB URLs).
# .env.example files ARE meant to be committed — only the real .env is ignored.
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- Build output ---
backend/dist/
frontend/dist/
*.tsbuildinfo

# --- Database ---
# SQLite dev database — everyone should run their own `npx prisma migrate dev`
# + `npm run seed` locally rather than sharing a binary DB file in git.
backend/*.db
backend/*.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# --- Uploaded files ---
# Patient clinical documents (lab results, imaging, referrals) uploaded
# through the app. Never belongs in git — it's user data, not source code.
backend/uploads/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Test / coverage ---
coverage/
