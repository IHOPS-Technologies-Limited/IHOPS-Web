# --- Database ---
# SQLite:
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma datasource to "postgresql" and use:
# DATABASE_URL="postgresql://user:password@host:5432/ihops"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"
SUPER_ADMIN_JWT_SECRET="replace-with-a-different-long-random-string"

# --- App ---
PORT=4000
APP_BASE_URL="http://localhost:5173"
NODE_ENV="development"

# --- Payments (Paystack) — mocked by default; set to enable real Paystack calls ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_ENABLED="false"

# --- Messaging providers — mocked by default (logged to console + stored in DB) ---
WHATSAPP_PROVIDER_ENABLED="false"
SMS_PROVIDER_ENABLED="false"
# SMS_PROVIDER="termii"
# SMS_API_KEY=""
# SMS_SENDER_ID="IHOPS"
# SMS_DEFAULT_COUNTRY_CODE="234"
# TERMII_BASE_URL="https://v4.api.termii.com"
# TERMII_CHANNEL="generic"
# AFRICASTALKING_USERNAME="sandbox"
EMAIL_PROVIDER_ENABLED="false"
# Resend transactional email (free plan: 3,000 emails/month, 100/day).
# Use Resend's test sender locally; replace it with a verified domain in production.
RESEND_API_KEY=""
RESEND_FROM=""

# --- AI reminder generation — mocked (template engine) unless an Anthropic key is set ---
ANTHROPIC_API_KEY=""
AI_REMINDERS_PROVIDER_ENABLED="false"

# --- Trial / grace period business rules (Section 11) ---
TRIAL_LENGTH_DAYS=7
GRACE_PERIOD_DAYS=5
